CONTROL_API_URL=https://gridflow-control-api.example.workers.dev
CONTROL_API_READ_TOKEN=replace-with-controller-read-token
CONTROL_API_ACTION_TOKEN=replace-with-controller-action-token
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-control-room-access-audience
CF_ACCESS_ALLOWED_EMAILS=controller.one@example.com,controller.two@example.com

# Test deployment only. Never set these in a live event environment.
GRIDFLOW_DEMO_MODE=true
GRIDFLOW_DEMO_CONTROLLER_ID=demo.controller@gridflow.test
